{
  "name": "functions",
  "description": "Firebase Cloud Functions for UNIOR Auditorium Reservation System",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.0.0",
    "pdfkit": "^0.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pdfkit": "^0.13.4",
    "typescript": "^5.3.2"
  },
  "private": true
}
